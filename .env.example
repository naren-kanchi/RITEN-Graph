# Copy to .env (python scripts/bootstrap_env.py does this and fills in random secrets).
# Never commit .env.
POSTGRES_DB=riten
POSTGRES_USER=riten_owner
POSTGRES_PASSWORD=change-me
APP_DB_USER=riten_app
APP_DB_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
NEO4J_URI=bolt://127.0.0.1:57687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
REDIS_URL=redis://127.0.0.1:56379/0
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
JWT_SECRET=change-me
JWT_TTL_MINUTES=120
COOKIE_SECURE=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_ANALYST_USERNAME=analyst
SEED_ANALYST_PASSWORD=change-me
